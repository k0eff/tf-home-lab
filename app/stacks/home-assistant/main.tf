resource "homeassistant_automation" "v2_xiaomi_temperature_sensors_low_battery_alert" {
  alias       = "[V2] Xiaomi temperature sensors - low battery alert"
  description = "Persistent notification for Xiaomi/Miaomiaoce temperature sensor batteries at or below 10%, throttled to once every 2 days."
  mode        = "single"

  trigger = jsonencode([
    {
      "platform" = "event"
      "event_type" = "state_changed"
      "id" = "battery_state_changed"
    },
    {
      "platform" = "homeassistant"
      "event" = "start"
      "id" = "homeassistant_start"
    },
    {
      "platform" = "time_pattern"
      "hours" = "/12"
      "id" = "periodic_check"
    }
  ])

  condition = jsonencode([
    {
      "condition" = "template"
      "value_template" = "{{ this.attributes.last_triggered is none or (now() - this.attributes.last_triggered).total_seconds() >= 172800 }}"
    },
    {
      "condition" = "template"
      "value_template" = "{% if trigger is defined and trigger.id == \"battery_state_changed\" %}\n  {% set ns = trigger.event.data.new_state %}\n  {% set os = trigger.event.data.old_state %}\n  {% set e = trigger.event.data.entity_id %}\n  {% set manufacturer = (device_attr(e, \"manufacturer\") or \"\") | lower %}\n  {% set model = (device_attr(e, \"model\") or \"\") | lower %}\n  {% set parent = ns.attributes.parent_entity_id | default(\"\", true) if ns is not none else \"\" %}\n  {% set parent_name = (state_attr(parent, \"friendly_name\") or \"\") | lower %}\n  {% set is_xiaomi_temp = (\"xiaomi\" in manufacturer or \"mijia\" in manufacturer or \"miaomiaoce\" in manufacturer or \"lumi\" in manufacturer or \"qingping\" in manufacturer) and (\"sensor_ht\" in model or \"temperature_humidity_sensor\" in parent or \"temperature humidity sensor\" in parent_name) %}\n  {{ ns is not none\n     and ns.attributes.device_class == \"battery\"\n     and ns.state not in [\"unknown\", \"unavailable\", \"none\"]\n     and (ns.state | float(999)) <= 10\n     and is_xiaomi_temp\n     and (os is none or os.state in [\"unknown\", \"unavailable\", \"none\"] or (os.state | float(999)) > 10) }}\n{% else %}\n  true\n{% endif %}"
    },
    {
      "condition" = "template"
      "value_template" = "{% set ns = namespace(count=0) %}\n{% for s in states.sensor %}\n  {% set manufacturer = (device_attr(s.entity_id, \"manufacturer\") or \"\") | lower %}\n  {% set model = (device_attr(s.entity_id, \"model\") or \"\") | lower %}\n  {% set parent = s.attributes.parent_entity_id | default(\"\", true) %}\n  {% set parent_name = (state_attr(parent, \"friendly_name\") or \"\") | lower %}\n  {% set is_xiaomi_temp = (\"xiaomi\" in manufacturer or \"mijia\" in manufacturer or \"miaomiaoce\" in manufacturer or \"lumi\" in manufacturer or \"qingping\" in manufacturer) and (\"sensor_ht\" in model or \"temperature_humidity_sensor\" in parent or \"temperature humidity sensor\" in parent_name) %}\n  {% if s.attributes.device_class == \"battery\" and s.state not in [\"unknown\", \"unavailable\", \"none\"] and (s.state | float(999)) <= 10 and is_xiaomi_temp %}\n    {% set ns.count = ns.count + 1 %}\n  {% endif %}\n{% endfor %}\n{{ ns.count > 0 }}"
    }
  ])

  action = jsonencode([
    {
      "service" = "persistent_notification.create"
      "data" = {
        "notification_id" = "xiaomi_temperature_sensors_low_battery"
        "title" = "Xiaomi temperature sensor low battery"
        "message" = "The following Xiaomi/Miaomiaoce temperature sensor batteries are at or below 10%:\n\n{% set ns = namespace(lines=[]) %}\n{% for s in states.sensor %}\n  {% set manufacturer = (device_attr(s.entity_id, \"manufacturer\") or \"\") | lower %}\n  {% set model = (device_attr(s.entity_id, \"model\") or \"\") | lower %}\n  {% set parent = s.attributes.parent_entity_id | default(\"\", true) %}\n  {% set parent_name = (state_attr(parent, \"friendly_name\") or \"\") | lower %}\n  {% set is_xiaomi_temp = (\"xiaomi\" in manufacturer or \"mijia\" in manufacturer or \"miaomiaoce\" in manufacturer or \"lumi\" in manufacturer or \"qingping\" in manufacturer) and (\"sensor_ht\" in model or \"temperature_humidity_sensor\" in parent or \"temperature humidity sensor\" in parent_name) %}\n  {% if s.attributes.device_class == \"battery\" and s.state not in [\"unknown\", \"unavailable\", \"none\"] and (s.state | float(999)) <= 10 and is_xiaomi_temp %}\n    {% set ns.lines = ns.lines + [\"- \" ~ s.entity_id ~ \" | \" ~ (s.attributes.friendly_name or s.name) ~ \" | \" ~ s.state ~ \"%\"] %}\n  {% endif %}\n{% endfor %}\n{{ ns.lines | join(\"\\n\") }}"
      }
    }
  ])
}

resource "homeassistant_automation" "test_lossnay_fan_boost" {
  alias       = "[TEST] Lossnay - fan boost"
  description = "Temporarily sets Lossnay fan speed to 4 for 30 or 60 min, then restores to 2."
  mode        = "restart"

  trigger = jsonencode([
    {
      "platform" = "state"
      "entity_id" = "input_button.lossnay_fan_boost_30m"
      "id" = "boost_30m"
    },
    {
      "platform" = "state"
      "entity_id" = "input_button.lossnay_fan_boost_60m"
      "id" = "boost_60m"
    },
    {
      "platform" = "state"
      "entity_id" = "input_boolean.lossnay_fan_boost_active"
      "to" = "off"
      "id" = "boost_cancelled"
    },
    {
      "platform" = "time_pattern"
      "minutes" = "/1"
      "id" = "boost_expiry_check"
    }
  ])

  condition = jsonencode([])

  action = jsonencode([
    {
      # Four branches selected purely by trigger.id (the two "activate" buttons,
      # the 1-minute expiry poll, and an explicit cancel). Re-pressing either
      # activate button while a boost is already running just overwrites the
      # expiry timestamp with a fresh one - there is no separate "extend"
      # branch because activating again already does that.
      "choose" = [
        {
          # Branch: 30-minute boost button pressed. Sets the expiry clock,
          # marks the boost active, and raises fan speed to 4.
          "alias" = "Activate 30min boost"
          "conditions" = [
            {
              "condition" = "template"
              "value_template" = "{{ trigger.id == 'boost_30m' }}"
            }
          ]
          "sequence" = [
            {
              "service" = "input_datetime.set_datetime"
              "target" = {
                "entity_id" = "input_datetime.lossnay_fan_boost_until"
              }
              "data" = {
                "datetime" = "{{ (now() + timedelta(minutes=30)).strftime('%Y-%m-%d %H:%M:%S') }}"
              }
            },
            {
              "service" = "input_boolean.turn_on"
              "target" = {
                "entity_id" = "input_boolean.lossnay_fan_boost_active"
              }
            },
            {
              "service" = "select.select_option"
              "target" = {
                "entity_id" = "select.venti_fan_speed"
              }
              "data" = {
                "option" = "4"
              }
            },
            {
              "service" = "logbook.log"
              "data" = {
                "name" = "Lossnay fan boost"
                "message" = "Boost started: speed 4 for 30 minutes"
                "entity_id" = "select.venti_fan_speed"
              }
            }
          ]
        },
        {
          # Branch: 60-minute boost button pressed. Same as the 30-minute
          # branch with a longer expiry; fan speed target is identical (4).
          "alias" = "Activate 60min boost"
          "conditions" = [
            {
              "condition" = "template"
              "value_template" = "{{ trigger.id == 'boost_60m' }}"
            }
          ]
          "sequence" = [
            {
              "service" = "input_datetime.set_datetime"
              "target" = {
                "entity_id" = "input_datetime.lossnay_fan_boost_until"
              }
              "data" = {
                "datetime" = "{{ (now() + timedelta(minutes=60)).strftime('%Y-%m-%d %H:%M:%S') }}"
              }
            },
            {
              "service" = "input_boolean.turn_on"
              "target" = {
                "entity_id" = "input_boolean.lossnay_fan_boost_active"
              }
            },
            {
              "service" = "select.select_option"
              "target" = {
                "entity_id" = "select.venti_fan_speed"
              }
              "data" = {
                "option" = "4"
              }
            },
            {
              "service" = "logbook.log"
              "data" = {
                "name" = "Lossnay fan boost"
                "message" = "Boost started: speed 4 for 60 minutes"
                "entity_id" = "select.venti_fan_speed"
              }
            }
          ]
        },
        {
          # Branch: the 1-minute poll fires, the boost is active, and its
          # "until" timestamp has passed. Restores fan speed to the baseline
          # (2) and clears the active flag - the natural-timeout counterpart
          # to the explicit cancel branch below.
          "alias" = "Expire boost"
          "conditions" = [
            {
              "condition" = "template"
              "value_template" = "{{ trigger.id == 'boost_expiry_check' and is_state('input_boolean.lossnay_fan_boost_active', 'on') and states('input_datetime.lossnay_fan_boost_until') not in ['unknown', 'unavailable', 'none'] and as_timestamp(states('input_datetime.lossnay_fan_boost_until'), 0) <= as_timestamp(now()) }}"
            }
          ]
          "sequence" = [
            {
              "service" = "select.select_option"
              "target" = {
                "entity_id" = "select.venti_fan_speed"
              }
              "data" = {
                "option" = "2"
              }
            },
            {
              "service" = "input_boolean.turn_off"
              "target" = {
                "entity_id" = "input_boolean.lossnay_fan_boost_active"
              }
            },
            {
              "service" = "logbook.log"
              "data" = {
                "name" = "Lossnay fan boost"
                "message" = "Boost expired; speed restored to 2"
                "entity_id" = "select.venti_fan_speed"
              }
            }
          ]
        },
        {
          # Branch: user cancels the boost directly. Unlike the expiry branch
          # it does not check whether the boost is currently active and does
          # not touch input_boolean.lossnay_fan_boost_active - restoring speed
          # 2 is safe even if pressed with no boost running, and something
          # (this or the next expiry tick) will still clear the flag if it was
          # set.
          "alias" = "Cancel boost"
          "conditions" = [
            {
              "condition" = "template"
              "value_template" = "{{ trigger.id == 'boost_cancelled' }}"
            }
          ]
          "sequence" = [
            {
              "service" = "select.select_option"
              "target" = {
                "entity_id" = "select.venti_fan_speed"
              }
              "data" = {
                "option" = "2"
              }
            },
            {
              "service" = "logbook.log"
              "data" = {
                "name" = "Lossnay fan boost"
                "message" = "Boost cancelled; speed restored to 2"
                "entity_id" = "select.venti_fan_speed"
              }
            }
          ]
        }
      ]
    }
  ])
}

resource "homeassistant_automation" "test_aircon_room_sensor_fluctuation_tracker" {
  alias       = "[TEST] AirCon - room sensor fluctuation tracker"
  description = "Tracks the last time each cloud-backed Xiaomi room temperature sensor (LivingR, BedroomB primary, BedroomB secondary) genuinely changed value, independent of unavailable-flicker state churn. Feeds the staleness guard used by the room sensor comfort band automations to fall back to the climate entity's own sensor when the room sensor value has not moved in the configured window."
  mode        = "queued"

  trigger = jsonencode([
    {
      "platform" = "state"
      "entity_id" = "sensor.miaomiaoce_t2_1228_temperature"
      "id" = "livingr_room_sensor_changed"
    },
    {
      "platform" = "state"
      "entity_id" = "sensor.miaomiaoce_t2_5249_temperature"
      "id" = "bedroomb_room_primary_sensor_changed"
    },
    {
      "platform" = "state"
      "entity_id" = "sensor.miaomiaoce_t2_faea_temperature"
      "id" = "bedroomb_room_secondary_sensor_changed"
    },
    {
      "platform" = "state"
      "entity_id" = "sensor.miaomiaoce_t2_f7cc_temperature"
      "id" = "bedrooms_room_sensor_changed"
    }
  ])

  condition = jsonencode([])

  action = jsonencode([
    {
      # One near-identical branch per tracked sensor (LivingR room, BedroomB
      # primary, BedroomB secondary, BedroomS room), each selected by its own
      # trigger.id. A branch only records a new "last seen" value and stamps
      # "last moved" if the new reading differs from the last recorded one by
      # >= 0.1 - a bare state-changed event on an unchanged value (Xiaomi
      # cloud sensors re-announce periodically) must NOT look like the sensor
      # is alive and moving. The room-sensor comfort bands read this
      # "last moved" timestamp as their staleness guard, so a sensor stuck
      # re-announcing the same frozen value reads as stale here too, even
      # though state_changed events keep firing for it.
      "choose" = [
        {
          # LivingR room sensor.
          "alias" = "Track livingr_room fluctuation"
          "conditions" = [
            {
              "condition" = "trigger"
              "id" = [
                "livingr_room_sensor_changed"
              ]
            },
            {
              "condition" = "template"
              "value_template" = "{{ trigger.to_state.state not in ['unknown', 'unavailable', 'none'] and (trigger.to_state.state | float(none)) is not none and ((trigger.to_state.state | float) - (states('input_number.livingr_room_last_seen_value') | float(trigger.to_state.state | float))) | abs >= 0.1 }}"
            }
          ]
          "sequence" = [
            {
              "service" = "input_number.set_value"
              "data" = {
                "entity_id" = "input_number.livingr_room_last_seen_value"
                "value" = "{{ trigger.to_state.state | float }}"
              }
            },
            {
              "service" = "input_datetime.set_datetime"
              "data" = {
                "entity_id" = "input_datetime.livingr_room_last_moved"
                "timestamp" = "{{ as_timestamp(now()) }}"
              }
            }
          ]
        },
        {
          # BedroomB primary room sensor.
          "alias" = "Track bedroomb_room_primary fluctuation"
          "conditions" = [
            {
              "condition" = "trigger"
              "id" = [
                "bedroomb_room_primary_sensor_changed"
              ]
            },
            {
              "condition" = "template"
              "value_template" = "{{ trigger.to_state.state not in ['unknown', 'unavailable', 'none'] and (trigger.to_state.state | float(none)) is not none and ((trigger.to_state.state | float) - (states('input_number.bedroomb_room_primary_last_seen_value') | float(trigger.to_state.state | float))) | abs >= 0.1 }}"
            }
          ]
          "sequence" = [
            {
              "service" = "input_number.set_value"
              "data" = {
                "entity_id" = "input_number.bedroomb_room_primary_last_seen_value"
                "value" = "{{ trigger.to_state.state | float }}"
              }
            },
            {
              "service" = "input_datetime.set_datetime"
              "data" = {
                "entity_id" = "input_datetime.bedroomb_room_primary_last_moved"
                "timestamp" = "{{ as_timestamp(now()) }}"
              }
            }
          ]
        },
        {
          # BedroomB secondary (ceiling) room sensor.
          "alias" = "Track bedroomb_room_secondary fluctuation"
          "conditions" = [
            {
              "condition" = "trigger"
              "id" = [
                "bedroomb_room_secondary_sensor_changed"
              ]
            },
            {
              "condition" = "template"
              "value_template" = "{{ trigger.to_state.state not in ['unknown', 'unavailable', 'none'] and (trigger.to_state.state | float(none)) is not none and ((trigger.to_state.state | float) - (states('input_number.bedroomb_room_secondary_last_seen_value') | float(trigger.to_state.state | float))) | abs >= 0.1 }}"
            }
          ]
          "sequence" = [
            {
              "service" = "input_number.set_value"
              "data" = {
                "entity_id" = "input_number.bedroomb_room_secondary_last_seen_value"
                "value" = "{{ trigger.to_state.state | float }}"
              }
            },
            {
              "service" = "input_datetime.set_datetime"
              "data" = {
                "entity_id" = "input_datetime.bedroomb_room_secondary_last_moved"
                "timestamp" = "{{ as_timestamp(now()) }}"
              }
            }
          ]
        },
        {
          # BedroomS room sensor.
          "alias" = "Track bedrooms_room fluctuation"
          "conditions" = [
            {
              "condition" = "trigger"
              "id" = [
                "bedrooms_room_sensor_changed"
              ]
            },
            {
              "condition" = "template"
              "value_template" = "{{ trigger.to_state.state not in ['unknown', 'unavailable', 'none'] and (trigger.to_state.state | float(none)) is not none and ((trigger.to_state.state | float) - (states('input_number.bedrooms_room_last_seen_value') | float(trigger.to_state.state | float))) | abs >= 0.1 }}"
            }
          ]
          "sequence" = [
            {
              "service" = "input_number.set_value"
              "data" = {
                "entity_id" = "input_number.bedrooms_room_last_seen_value"
                "value" = "{{ trigger.to_state.state | float }}"
              }
            },
            {
              "service" = "input_datetime.set_datetime"
              "data" = {
                "entity_id" = "input_datetime.bedrooms_room_last_moved"
                "timestamp" = "{{ as_timestamp(now()) }}"
              }
            }
          ]
        }
      ]
    }
  ])
}

resource "homeassistant_automation" "test_aircon_xiaomi_miot_self_heal_reload" {
  alias       = "[TEST] AirCon - xiaomi_miot self-heal reload"
  description = "If none of the tracked room sensors (LivingR, BedroomB primary/secondary, BedroomS) have genuinely moved within input_number.xiaomi_miot_self_heal_stale_hours, reloads the xiaomi_miot config entry to force a fresh cloud session. Gated by input_number.xiaomi_miot_self_heal_cooldown_hours so a real gateway/network outage does not cause reload looping. Posts a persistent_notification either way so a recurring failure (which a session reload cannot fix, e.g. the physical gateway itself being offline) is visible."
  mode        = "single"

  trigger = jsonencode([
    {
      "platform" = "time_pattern"
      "minutes" = "/30"
      "id" = "periodic_check"
    }
  ])

  condition = jsonencode([
    {
      "condition" = "template"
      "value_template" = "{{ [(as_timestamp(now()) - as_timestamp(states(\"input_datetime.livingr_room_last_moved\"))) / 3600, (as_timestamp(now()) - as_timestamp(states(\"input_datetime.bedroomb_room_primary_last_moved\"))) / 3600, (as_timestamp(now()) - as_timestamp(states(\"input_datetime.bedroomb_room_secondary_last_moved\"))) / 3600, (as_timestamp(now()) - as_timestamp(states(\"input_datetime.bedrooms_room_last_moved\"))) / 3600] | min >= states(\"input_number.xiaomi_miot_self_heal_stale_hours\") | float }}"
    },
    {
      "condition" = "template"
      "value_template" = "{{ (as_timestamp(now()) - as_timestamp(states('input_datetime.xiaomi_miot_self_heal_last_attempt'))) / 3600 >= states('input_number.xiaomi_miot_self_heal_cooldown_hours') | float }}"
    }
  ])

  action = jsonencode([
    {
      "service" = "input_datetime.set_datetime"
      "data" = {
        "entity_id" = "input_datetime.xiaomi_miot_self_heal_last_attempt"
        "timestamp" = "{{ as_timestamp(now()) }}"
      }
    },
    {
      "service" = "homeassistant.reload_config_entry"
      "data" = {
        "entry_id" = "9122367f13a71956c9cd948ada6e2632"
      }
    },
    {
      "service" = "persistent_notification.create"
      "data" = {
        "notification_id" = "xiaomi_miot_self_heal"
        "title" = "Xiaomi cloud self-heal reload"
        "message" = "Room sensors (LivingR/BedroomB/BedroomS) had not genuinely moved in over {{ states(\"input_number.xiaomi_miot_self_heal_stale_hours\") }}h, so the xiaomi_miot integration was reloaded. If this keeps recurring, a session reload will not help - check whether the physical Aqara/Lumi gateway shows offline in the Mi Home app."
      }
    }
  ])
}

resource "homeassistant_automation" "test_aircon_bedrooms_room_sensor_comfort_band" {
  alias       = "[TEST] AirCon - BedroomS - room sensor comfort band"
  description = "Test automation for BedroomS climate.v537_spalniam_2. Uses BedroomS room temperature sensor while its battery is above the configurable room-sensor battery helper; falls back to climate current_temperature below that. Climate mode is based on configurable outside thresholds and an outside temperature fallback chain: Venti In 7 minus the configurable offset, then weather.forecast_home temperature, then sensor.venti_outside_temperature. Dynamic setpoint = climate_sensor_temperature - (effective_room_temperature - target). The main comfort target, start delta, hot-summer target, outdoor thresholds, winter target, fan mode, coil cool-down minutes, learned overshoot, Venti offset, and sensor battery thresholds are all exposed through BedroomS tuning input_number helpers. Mild summer is tuned as a configurable comfort band: cooling starts above target + start delta and moves to fan_only at target + learned overshoot. The learned overshoot is updated from each cool-down cycle using 70/30 smoothing. Night sleep window 00:30-08:30 blocks comfort cooling/heating and keeps the climate off, except the 03:00-06:00 air-clean window which uses fan_only + fan 5 in both seasons. During daytime, no BedroomS motion for 15m raises fan to 5 only while the climate is already in fan_only; motion restores fan 3 in fan_only. Uses climate.set_hvac_mode: off because this climate entity uses climate.set_hvac_mode: off instead of climate.turn_off, matching the other rooms' comfort-band automations. RETURN BOOST: while input_boolean.bedrooms_was_away was on and away_now becomes false (motion resumes or someone comes home), input_datetime.bedrooms_away_ended_at is stamped with now(). For input_number.bedrooms_return_boost_minutes minutes after that timestamp, cooling_fan_mode is forced to input_number.bedrooms_return_boost_fan_mode instead of the normal input_number.bedrooms_cooling_fan_mode, so air actually circulates fast enough to pull the real room down to target quickly after an away period, instead of slowly chasing a compensated setpoint at low fan speed. Intent: the away-relax band exists to save energy while empty, not to make the return transition slow - the boost undoes that trade the moment someone is back. FAN-SPEED BOOST: when |error| (effective - target) crosses input_number.bedrooms_fan_boost_threshold (default 1.0C) in either direction, input_boolean.bedrooms_fan_boost_active latches on (a new \"Track fan-speed boost latch\" action, mirroring the return-boost tracker) and releases only once |error| drops below (threshold - input_number.bedrooms_fan_boost_release_margin, default 0.5C). This latch is OR-combined with the existing return_boost_active condition inside cooling_fan_mode, so both triggers share the same input_number.bedrooms_return_boost_fan_mode speed and override fan_mode regardless of hvac/fan_only phase (night air-clean, daytime no-motion raise, daytime motion-restore, winter heat all became boost-aware). Symmetric for summer overshoot and winter undershoot."
  mode        = "single"

  trigger = jsonencode([
    {
      "platform" = "time_pattern"
      "minutes" = "/5"
      "id" = "periodic_check"
    },
    {
