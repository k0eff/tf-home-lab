    {
      "platform" = "state"
      "entity_id" = "binary_sensor.motion03"
      "from" = "on"
      "to" = "off"
      "for" = {
        "minutes" = 15
      }
      "id" = "bedroomb_no_motion_15m"
    },
    {
      "platform" = "state"
      "entity_id" = "binary_sensor.motion03"
      "from" = "off"
      "to" = "on"
      "id" = "bedroomb_motion"
    }
  ])

  condition = jsonencode([
